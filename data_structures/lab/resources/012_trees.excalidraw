      "boundElements": [],
      "updated": 1776713873766,
      "link": null,
      "locked": false,
      "text": "1. If current value is nil\n    2. Return false\n3. Else\n    1. If input is equal to current value\n        2. Return true\n    3. Else\n        4. If input is less than current value\n            5. Move to the left\n            6. Go to the line 1\n        7. Else\n            8. Move to the right\n            9. Go to the line 1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. If current value is nil\n    2. Return false\n3. Else\n    1. If input is equal to current value\n        2. Return true\n    3. Else\n        4. If input is less than current value\n            5. Move to the left\n            6. Go to the line 1\n        7. Else\n            8. Move to the right\n            9. Go to the line 1",
      "autoResize": true,
      "lineHeight": 1.25
