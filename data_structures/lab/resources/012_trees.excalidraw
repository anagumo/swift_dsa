      "isDeleted": false,
      "boundElements": [],
      "updated": 1776713096476,
      "link": null,
      "locked": false,
      "text": "1. Create a new node to insert\n2. If current value is nil\n    3. Insert new node\n    4. Exit\n5. Else\n    7. If new value is less than current value\n        8. Move to the left\n        10. Go to line 2\n    11. Else\n        12. Move to the right\n        13. Go to line 2",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create a new node to insert\n2. If current value is nil\n    3. Insert new node\n    4. Exit\n5. Else\n    7. If new value is less than current value\n        8. Move to the left\n        10. Go to line 2\n    11. Else\n        12. Move to the right\n        13. Go to line 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
