    {
      "id": "mntcKVwcwvkWvS8wMtAHE",
      "type": "text",
      "x": 369,
      "y": 285.5,
      "width": 355.27972412109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
