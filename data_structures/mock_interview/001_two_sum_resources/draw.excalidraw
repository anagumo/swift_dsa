      "isDeleted": true,
      "boundElements": null,
      "updated": 1774300016049,
      "link": null,
      "locked": false,
      "text": "Time complexity \n-> O(n) where while node.next != nil\n-> O(n) linear complexity because the work is based on the size of the list\n- In the worst case reads all elements in the list\n- In the best case the first element is the n position - O(1) efective",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time complexity \n-> O(n) where while node.next != nil\n-> O(n) linear complexity because the work is based on the size of the list\n- In the worst case reads all elements in the list\n- In the best case the first element is the n position - O(1) efective",
      "autoResize": true,
      "lineHeight": 1.25
    },
