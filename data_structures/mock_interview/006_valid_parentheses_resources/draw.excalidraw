    {
      "id": "AdA8tfpRMhzHpYRXiCa64",
      "type": "text",
      "x": 402.37917329228065,
      "y": 597.3590714449028,
      "width": 559.551513671875,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 1886066152,
      "version": 1909,
      "versionNonce": 848329448,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776186179346,
      "link": null,
      "locked": false,
      "text": "1. Pick up the string\n2. Read the next character on the string\n3. Peek on the top of stack\n    // Early exit\n    4. If the top is nil and the first character is a closed element\n        // Must empty the stack before exit\n        5. Return false\n    6. Else if the top is open and comes close element of the same type\n        7. Pop the top of stack\n        8. Go back to line 2\n    9. Else\n        10. Push it on the stack\n        11. Go back to line 2\n12. If the Stack is empty\n    13. Return true\n14. Else\n    // Must empty the stack before exit\n    15. Return false\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Pick up the string\n2. Read the next character on the string\n3. Peek on the top of stack\n    // Early exit\n    4. If the top is nil and the first character is a closed element\n        // Must empty the stack before exit\n        5. Return false\n    6. Else if the top is open and comes close element of the same type\n        7. Pop the top of stack\n        8. Go back to line 2\n    9. Else\n        10. Push it on the stack\n        11. Go back to line 2\n12. If the Stack is empty\n    13. Return true\n14. Else\n    // Must empty the stack before exit\n    15. Return false\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sGi_zqI0lmg9uD9EVm0f_",
