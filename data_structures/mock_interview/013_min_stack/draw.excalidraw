    {
      "id": "WSSvL6xJI5teVDBF3gQDW",
      "type": "text",
      "x": 420.2343112420431,
      "y": 999.4061674315855,
      "width": 367.4716491699219,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1437998033,
      "version": 4928,
      "versionNonce": 1383763767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778788102664,
      "link": null,
      "locked": false,
      "text": "1. create two stacks, main and min\n2. if stacks are empty\n    3. return\n4. else\n    5. for a push action\n        6. push current number in main stack\n        7. If current number is less than min top\n            8. push current number in min stack\n        9. Else\n            10. push the last min in min stack\n    11. for a pop action\n        12. pop the last node of main stack\n        13. pop the last node of min stack\n    14. for a top action\n        15. return the peek of main stack\n    16. for a min action\n        17. return the peek of min stack\n18. exit\n        ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. create two stacks, main and min\n2. if stacks are empty\n    3. return\n4. else\n    5. for a push action\n        6. push current number in main stack\n        7. If current number is less than min top\n            8. push current number in min stack\n        9. Else\n            10. push the last min in min stack\n    11. for a pop action\n        12. pop the last node of main stack\n        13. pop the last node of min stack\n    14. for a top action\n        15. return the peek of main stack\n    16. for a min action\n        17. return the peek of min stack\n18. exit\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
