      "updated": 1777394172544,
      "link": null,
      "locked": false,
      "text": "run in O(n) time and O(1) as aditional space\n-> O(3)\n-> 3 steps since the work is based on the input size\nIn the worst case we read all the numbers\nIn the best case the first two numbers add up to the target",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "run in O(n) time and O(1) as aditional space\n-> O(3)\n-> 3 steps since the work is based on the input size\nIn the worst case we read all the numbers\nIn the best case the first two numbers add up to the target",
      "autoResize": true,
      "lineHeight": 1.25
    },
