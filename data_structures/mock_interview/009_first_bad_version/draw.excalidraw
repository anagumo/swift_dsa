      "locked": false,
      "text": "mid = (low + high) / 2\nmid = (0 + 4) / 2\nmid = 2",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "mid = (low + high) / 2\nmid = (0 + 4) / 2\nmid = 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
