      "updated": 1777059684174,
      "link": null,
      "locked": false,
      "text": "isBadVersion(2)\n-> 2 >= 3\n-> false\n\nisBadVersion(5)\n-> 5 >= 3\n-> true\n\nisBadVersion(3)\n-> 3 >= 3\n-> true",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "isBadVersion(2)\n-> 2 >= 3\n-> false\n\nisBadVersion(5)\n-> 5 >= 3\n-> true\n\nisBadVersion(3)\n-> 3 >= 3\n-> true",
      "autoResize": true,
      "lineHeight": 1.25
    },
