    {
      "id": "mn5cpBQevo6Oz-1TUXEs2",
      "type": "text",
      "x": 392.8265747064143,
      "y": 1144.222501235411,
      "width": 360.8956604003906,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 1322160576,
      "version": 608,
      "versionNonce": 1382447547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777061137998,
      "link": null,
      "locked": false,
      "text": "1. Read the input of the user\n2. Set low to zero and high to n\n3. While low is less or equal than high\n    4. If mid is bad version\n        5. High is equal to mid\n    6. Else\n        7. Low is equal to mid + 1\n8. Return low because is the first bad version",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Read the input of the user\n2. Set low to zero and high to n\n3. While low is less or equal than high\n    4. If mid is bad version\n        5. High is equal to mid\n    6. Else\n        7. Low is equal to mid + 1\n8. Return low because is the first bad version",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DsErViIdBKxLa054JB0hZ",
      "type": "text",
      "x": 713.478046742566,
      "y": 845.1801848494389,
      "width": 139.59983825683594,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1L",
      "roundness": null,
      "seed": 1066904181,
      "version": 176,
      "versionNonce": 1764567419,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777059998360,
      "link": null,
      "locked": false,
      "text": "isBadVersion(mid)\n    low = 0\n    hight = 2\nelse\n    low = 0\n    hight = mid + 1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "isBadVersion(mid)\n    low = 0\n    hight = 2\nelse\n    low = 0\n    hight = mid + 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
