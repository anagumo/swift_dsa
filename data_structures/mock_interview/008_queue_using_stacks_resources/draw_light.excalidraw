    {
      "id": "SehPeUolGivf0gWPR7p9-",
      "type": "text",
      "x": -2033.4497079798575,
      "y": -2586.8735255829947,
      "width": 689.9596557617188,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 1822827009,
      "version": 2013,
      "versionNonce": 1971523855,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776701734978,
      "link": null,
      "locked": false,
      "text": "1. Create a stack to push elements\n2. Create a stack to pop elements\n3. For a push\n    4. If push stack is empty\n        5. Head is equal to new node\n    6. Else\n        7. Create new node\n        8. New node next is equal to head\n        9. Head is equal to new node\n10. For a pop\n    11. If pop stack is empty\n        12. Return nil\n    13. Else\n        11. Reverse the push stack into the pop stack\n        12. Pop the node at the top\n        13. For every pop will be valid delete the tail of the push stack \n            or should I reverse the pop stack into the push stack\n        14. Clean the pop stack\n11. For a peek...",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Create a stack to push elements\n2. Create a stack to pop elements\n3. For a push\n    4. If push stack is empty\n        5. Head is equal to new node\n    6. Else\n        7. Create new node\n        8. New node next is equal to head\n        9. Head is equal to new node\n10. For a pop\n    11. If pop stack is empty\n        12. Return nil\n    13. Else\n        11. Reverse the push stack into the pop stack\n        12. Pop the node at the top\n        13. For every pop will be valid delete the tail of the push stack \n            or should I reverse the pop stack into the push stack\n        14. Clean the pop stack\n11. For a peek...",
      "autoResize": true,
      "lineHeight": 1.25
    }
