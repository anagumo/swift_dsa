      "text": "input: [\"MyQueue\", \"push\", \"push\", \"peek\", \"pop\", \"empty\"]\noutput: [nil, nil, nil, 1, 2, false]\n\n1. `[]`\n -> push 1: `[1]`\n -> push 2: `[1, 2]`\n -> peek: `1`\n -> pop: `1`\n -> empty: `false`",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "input: [\"MyQueue\", \"push\", \"push\", \"peek\", \"pop\", \"empty\"]\noutput: [nil, nil, nil, 1, 2, false]\n\n1. `[]`\n -> push 1: `[1]`\n -> push 2: `[1, 2]`\n -> peek: `1`\n -> pop: `1`\n -> empty: `false`",
      "autoResize": true,
      "lineHeight": 1.25
    },
