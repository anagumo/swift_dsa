    {
      "id": "wIbFAt3MfPz5rSI-fJ4qh",
      "type": "text",
      "x": 452.08519922783273,
      "y": 264.08470160153206,
      "width": 692.259521484375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 1321753086,
      "version": 416,
      "versionNonce": 857148322,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775001269839,
      "link": null,
      "locked": false,
      "text": "If the set is smaller than the size of the array means:\n- that the Set doesn't store duplicated elements\n- I could use a Set to know if an array has duplicated elements in 0(1)\n- Use an array is the worst option with O(n^2) qudratic time",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the set is smaller than the size of the array means:\n- that the Set doesn't store duplicated elements\n- I could use a Set to know if an array has duplicated elements in 0(1)\n- Use an array is the worst option with O(n^2) qudratic time",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WXyyQqBdfnfu9hNsRzpNy",
      "type": "text",
      "x": 454.47134792086797,
      "y": 453.3780723898711,
      "width": 200.84393310546875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 1932757374,
      "version": 27,
      "versionNonce": 345518754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775001264605,
      "link": null,
      "locked": false,
      "text": "array / O(n^2)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "array / O(n^2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YZV6nGWSjrhJDNrFz51MT",
      "type": "text",
      "x": 460.55855137664565,
      "y": 618.4272460566058,
      "width": 487.439697265625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1284036066,
      "version": 386,
      "versionNonce": 1551734114,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775001883774,
      "link": null,
      "locked": false,
      "text": "Time:\n-> O(n^2) where forEach(element) == nextElement\n-> O(n^2) quadratic algorithm complexity\n-> O(5^2) -> 25 steps in the worst case\nSpace:\n-> O(1) where nextElement\n-> O(1) constant algorithm complexity ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time:\n-> O(n^2) where forEach(element) == nextElement\n-> O(n^2) quadratic algorithm complexity\n-> O(5^2) -> 25 steps in the worst case\nSpace:\n-> O(1) where nextElement\n-> O(1) constant algorithm complexity ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jMLWr9YZ0NuAjWTrVp_yP",
      "type": "text",
      "x": 1259.0402798909872,
      "y": 464.36325272081683,
      "width": 100.61993408203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 149904702,
      "version": 73,
      "versionNonce": 1289466174,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775002126421,
      "link": null,
      "locked": false,
      "text": "set / O(1)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "set / O(1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cKvLwyncCBZxnvXii9geG",
      "type": "text",
      "x": 1243.2331215374631,
      "y": 612.9713658429711,
      "width": 360.23974609375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1429113150,
      "version": 221,
      "versionNonce": 453958014,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775002126421,
      "link": null,
      "locked": false,
      "text": "Time:\n-> O(n) where forEach(element)\n-> O(1) where set.containsDuplicated\n-> O(n) linear algorithm complexity\n-> O(4) -> 4 steps in the worst case",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
