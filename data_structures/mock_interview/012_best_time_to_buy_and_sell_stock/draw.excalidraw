    {
      "id": "WSSvL6xJI5teVDBF3gQDW",
      "type": "text",
      "x": 426.0441050200474,
      "y": 1114.341049316647,
      "width": 436.12762451171875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
