      "link": null,
      "locked": false,
      "text": "-> O(n) where dictionary1.contains(dictionary2) \nshould work? a:1 bucket in dict1 is the same a:1 bucket in dict2 in memory?\n-> O(n) linear algorithm complexity (ALWAYS)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> O(n) where dictionary1.contains(dictionary2) \nshould work? a:1 bucket in dict1 is the same a:1 bucket in dict2 in memory?\n-> O(n) linear algorithm complexity (ALWAYS)",
      "autoResize": true,
      "lineHeight": 1.25
    },
