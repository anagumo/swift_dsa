    {
      "id": "Ov-TrpnFBEK4cjy5KFtvu",
      "type": "text",
      "x": 297.6691160786637,
      "y": 1411.7689925598158,
      "width": 828.4593505859375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
