      "isDeleted": false,
      "boundElements": [],
      "updated": 1775162576599,
      "link": null,
      "locked": false,
      "text": "-> call play function\n    -> create frame in the Stack\n    -> alloc closure in the Heap\n    -> closure captures self, retain count +1\n    -> store ptr in the Heap, inside closure object\n    -> store self ptr in the Stack\n    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> call play function\n    -> create frame in the Stack\n    -> alloc closure in the Heap\n    -> closure captures self, retain count +1\n    -> store ptr in the Heap, inside closure object\n    -> store self ptr in the Stack\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
